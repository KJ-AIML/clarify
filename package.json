{
  "name": "@clarify/skill",
  "version": "0.2.0",
  "description": "Interactive architecture and decision briefs for AI coding agents. Markdown in, one zero-dependency HTML page out.",
  "type": "module",
  "main": "src/render.js",
  "bin": {
    "clarify": "bin/clarify.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "visual": "node test/visual/run.mjs",
    "visual:update": "node test/visual/run.mjs --update"
  },
  "files": [
    "bin",
    "src",
    "SKILL.md",
    "README.md",
    "examples",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "references"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-skills",
    "architecture-diagrams",
    "visualizer",
    "ai-agent",
    "claude-code",
    "interactive-diagrams"
  ],
  "author": "KJ-AIML",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KJ-AIML/clarify.git"
  },
  "homepage": "https://github.com/KJ-AIML/clarify#readme",
  "bugs": {
    "url": "https://github.com/KJ-AIML/clarify/issues"
  }
}
